# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://username:password@cluster.mongodb.net:27017/database?ssl=true&replicaSet=name&authSource=admin&appName=app

# JWT Authentication
JWT_SECRET=your-secret-key-here-at-least-32-chars
JWT_EXPIRE=7d

# Client URL (CORS origin)
CLIENT_URL=http://localhost:3000
